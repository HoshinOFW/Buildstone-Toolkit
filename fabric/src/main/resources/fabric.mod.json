{
  "schemaVersion": 1,
  "id": "buildstonetoolkit",
  "version": "${version}",
  "name": "Buildstone Toolkit",
  "description": "A mod to bring new tools that enhance the aesthetic capabilities of vanilla redstone",
  "authors": [
    "HoshinOFW"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.hoshin.buildstonetoolkit.fabric.core.BuildstoneToolkitFabric"
    ],
    "client": [
      "com.hoshin.buildstonetoolkit.fabric.core.BuildstoneToolkitFabricClient"
    ]
  },
  "mixins": [
    "buildstonetoolkit.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.3",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "architectury": ">=13.0.8",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}
